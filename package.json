{
  "name": "noteflow-desktop",
  "version": "1.0.0",
  "description": "NoteFlow — Professional Digital Notebook Software",
  "main": "electron/main.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "start:desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder --win nsis portable --x64",
    "dist:fast": "electron-builder --win --x64"
  },
  "author": "NoteFlow",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.noteflow.app",
    "productName": "NoteFlow",
    "copyright": "Copyright © 2026 NoteFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{log,map,ts,tsx}"
    ],
    "forceCodeSigning": false,
    "win": {
      "sign": null,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteFlow"
    }
  }
}
