{
  "name": "noteflow-desktop",
  "version": "1.0.0",
  "description": "NoteFlow — Professional Digital Notebook Software",
  "main": "electron/main.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "node backend/src/server.js",
    "start:backend": "node backend/src/server.js",
    "start:desktop": "electron .",
    "open:desktop": "powershell Start-Process release/win-unpacked/NoteFlow.exe",
    "pack": "node scripts/build-desktop.js",
    "build:desktop": "node scripts/build-desktop.js",
    "build:zip": "node scripts/build-desktop.js && powershell Compress-Archive -Path release/win-unpacked/* -DestinationPath release/NoteFlow-Windows-x64.zip -Force",
    "dist": "node scripts/build-desktop.js"
  },
  "author": "NoteFlow",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.noteflow.app",
    "productName": "NoteFlow",
    "copyright": "Copyright © 2026 NoteFlow",
    "icon": "build-assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{log,map,ts,tsx}"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "build-assets/icon.ico",
      "sign": null,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NoteFlow"
    }
  }
}
